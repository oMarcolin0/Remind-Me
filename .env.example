# ─── Supabase ────────────────────────────────────────────────────────────────
# URL da sua instância Supabase (local ou nuvem)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Supabase (Server/Bot only — never expose to frontend) ───────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Token do bot (obtenha em t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Username do bot SEM o @ (ex: Rem1ndeM3Bot)
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername

# Porta do servidor Express do bot (opcional, padrão: 3001)
TELEGRAM_BOT_PORT=3001

# ─── Webhook Security ────────────────────────────────────────────────────────
# Segredo para validar chamadas do Telegram ao webhook (opcional mas recomendado)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your_random_secret_here
